# --- API (api/.env) ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://soms:CHANGE_ME@localhost:5432/soms
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_LONG_SECRET_HERE
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
APP_TIMEZONE=Africa/Algiers
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CHANGE_ME_MIN_10_CHARS
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ANALYTICS_URL=http://localhost:5000
INTERNAL_API_KEY=CHANGE_ME_LONG_RANDOM_KEY_MIN_32_CHARS
# Postgres password (also used in docker-compose)
POSTGRES_PASSWORD=CHANGE_ME

