// prisma/schema.prisma
// System 0: init — no models
// System 1: companies, users, refresh_tokens
// System 2: administrative_requests
// System 3: activity_logs, system_settings

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  super_admin
  company_admin
  analyst
  viewer
}

enum CompanyStatus {
  active
  inactive
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum SourceType {
  public_manual
  csv_import
  official_api
  synthetic_demo
}

enum Platform {
  instagram
  facebook
  tiktok
  other
}

enum ContentType {
  image
  video
  reel
  carousel
  story
  text
  other
}

enum ImportType {
  social_posts
  regional_metrics
  sales_records
}

enum ImportStatus {
  previewed
  processing
  completed
  completed_with_errors
  failed
  cancelled
}

enum MetricType {
  impressions
  clicks
  conversions
  spend
  orders
  revenue
  followers
  profit_margin
}

enum ReportType {
  geo
  growth
  scheduler
  forecast
  combined
}

// ── System 1 Tables ───────────────────────────────────────────────────────────

model Company {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String        @db.VarChar(150)
  registrationNumber  String?       @unique @db.VarChar(50) @map("registration_number")
  industry            String?       @db.VarChar(100)
  email               String?       @db.VarChar(255)
  phone               String?       @db.VarChar(30)
  address             String?
  logoUrl             String?       @map("logo_url")
  logoPublicId        String?       @map("logo_public_id")
  status              CompanyStatus @default(active)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  users                  User[]
  administrativeRequests AdministrativeRequest[]
  activityLogs           ActivityLog[]

  @@map("companies")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String?   @map("company_id") @db.Uuid
  fullName          String    @db.VarChar(120) @map("full_name")
  email             String    @db.VarChar(255)
  passwordHash      String    @map("password_hash")
  role              Role
  isActive          Boolean   @default(true) @map("is_active")
  avatarUrl         String?   @map("avatar_url")
  avatarPublicId    String?   @map("avatar_public_id")
  preferredLanguage String    @default("ar") @db.VarChar(2) @map("preferred_language")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company              Company?               @relation(fields: [companyId], references: [id])
  refreshTokens        RefreshToken[]
  reviewedRequests     AdministrativeRequest[] @relation("RequestReviewer")
  activityLogs         ActivityLog[]
  updatedSettings      SystemSetting[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @db.Char(64) @map("token_hash")
  familyId    String    @map("family_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  replacedBy  String?   @map("replaced_by") @db.Uuid
  userAgent   String?   @map("user_agent")
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ── System 2 Tables ───────────────────────────────────────────────────────────

model AdministrativeRequest {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName         String        @db.VarChar(150) @map("company_name")
  registrationNumber  String?       @db.VarChar(50) @map("registration_number")
  industry            String?       @db.VarChar(100)
  contactPhone        String?       @db.VarChar(30) @map("contact_phone")
  applicantFullName   String        @db.VarChar(120) @map("applicant_full_name")
  applicantEmail      String        @db.VarChar(255) @map("applicant_email")
  passwordHash        String?       @map("password_hash")
  status              RequestStatus @default(pending)
  reviewedBy          String?       @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?     @map("reviewed_at") @db.Timestamptz
  decisionNote        String?       @map("decision_note")
  createdCompanyId    String?       @map("created_company_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz

  reviewer            User?         @relation("RequestReviewer", fields: [reviewedBy], references: [id])
  createdCompany      Company?      @relation(fields: [createdCompanyId], references: [id])

  @@map("administrative_requests")
}

// ── System 3 Tables ───────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  action      String   @db.VarChar(60)
  entityType  String?  @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  ip          String?  @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor   User?    @relation(fields: [actorUserId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model SystemSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("system_settings")
}
