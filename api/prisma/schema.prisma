// prisma/schema.prisma
// System 0: init — no models
// System 1: companies, users, refresh_tokens
// System 2: administrative_requests
// System 3: activity_logs, system_settings
// System 4: wilayas, data_imports, data_import_errors, social_posts, regional_metrics, sales_records

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  super_admin
  company_admin
  analyst
  viewer
}

enum CompanyStatus {
  active
  inactive
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum SourceType {
  public_manual
  csv_import
  official_api
  synthetic_demo
}

enum Platform {
  instagram
  facebook
  tiktok
  other
}

enum ContentType {
  image
  video
  reel
  carousel
  story
  text
  other
}

enum ImportType {
  social_posts
  regional_metrics
  sales_records
}

enum ImportStatus {
  previewed
  processing
  completed
  completed_with_errors
  failed
  cancelled
}

enum MetricType {
  impressions
  clicks
  conversions
  spend
  orders
  revenue
  followers
  profit_margin
}

enum ReportType {
  geo
  growth
  scheduler
  forecast
  combined
}

// ── System 1 Tables ───────────────────────────────────────────────────────────

model Company {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String        @db.VarChar(150)
  registrationNumber  String?       @unique @db.VarChar(50) @map("registration_number")
  industry            String?       @db.VarChar(100)
  email               String?       @db.VarChar(255)
  phone               String?       @db.VarChar(30)
  address             String?
  logoUrl             String?       @map("logo_url")
  logoPublicId        String?       @map("logo_public_id")
  status              CompanyStatus @default(active)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  users                  User[]
  administrativeRequests AdministrativeRequest[]
  activityLogs           ActivityLog[]
  // System 4
  dataImports            DataImport[]
  socialPosts            SocialPost[]
  regionalMetrics        RegionalMetric[]
  salesRecords           SalesRecord[]
  // System 7
  scheduledItems         ScheduledItem[]
  // System 8
  simulations            CampaignSimulation[]
  // System 9
  reports                Report[]

  @@map("companies")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String?   @map("company_id") @db.Uuid
  fullName          String    @db.VarChar(120) @map("full_name")
  email             String    @db.VarChar(255)
  passwordHash      String    @map("password_hash")
  role              Role
  isActive          Boolean   @default(true) @map("is_active")
  avatarUrl         String?   @map("avatar_url")
  avatarPublicId    String?   @map("avatar_public_id")
  preferredLanguage String    @default("ar") @db.VarChar(2) @map("preferred_language")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company              Company?               @relation(fields: [companyId], references: [id])
  refreshTokens        RefreshToken[]
  reviewedRequests     AdministrativeRequest[] @relation("RequestReviewer")
  activityLogs         ActivityLog[]
  updatedSettings      SystemSetting[]
  // System 4
  dataImports          DataImport[]           @relation("ImportedBy")
  // System 7
  scheduledItems       ScheduledItem[]        @relation("ScheduledBy")
  // System 8
  simulations          CampaignSimulation[]   @relation("SimulationCreator")
  // System 9
  reports              Report[]               @relation("ReportCreator")

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @db.Char(64) @map("token_hash")
  familyId    String    @map("family_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  replacedBy  String?   @map("replaced_by") @db.Uuid
  userAgent   String?   @map("user_agent")
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ── System 2 Tables ───────────────────────────────────────────────────────────

model AdministrativeRequest {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName         String        @db.VarChar(150) @map("company_name")
  registrationNumber  String?       @db.VarChar(50) @map("registration_number")
  industry            String?       @db.VarChar(100)
  contactPhone        String?       @db.VarChar(30) @map("contact_phone")
  applicantFullName   String        @db.VarChar(120) @map("applicant_full_name")
  applicantEmail      String        @db.VarChar(255) @map("applicant_email")
  passwordHash        String?       @map("password_hash")
  status              RequestStatus @default(pending)
  reviewedBy          String?       @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?     @map("reviewed_at") @db.Timestamptz
  decisionNote        String?       @map("decision_note")
  createdCompanyId    String?       @map("created_company_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz

  reviewer            User?         @relation("RequestReviewer", fields: [reviewedBy], references: [id])
  createdCompany      Company?      @relation(fields: [createdCompanyId], references: [id])

  @@map("administrative_requests")
}

// ── System 3 Tables ───────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  action      String   @db.VarChar(60)
  entityType  String?  @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  ip          String?  @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor   User?    @relation(fields: [actorUserId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model SystemSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("system_settings")
}

// ── System 4 Tables ───────────────────────────────────────────────────────────

model Wilaya {
  code     String  @id @db.Char(2)
  nameAr   String  @db.VarChar(80) @map("name_ar")
  nameFr   String  @db.VarChar(80) @map("name_fr")
  nameEn   String  @db.VarChar(80) @map("name_en")
  aliases  String[]
  isActive Boolean @default(true) @map("is_active")

  regionalMetrics RegionalMetric[]
  salesRecords    SalesRecord[]

  @@map("wilayas")
}

model DataImport {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  importType   ImportType   @map("import_type")
  sourceType   SourceType   @default(csv_import) @map("source_type")
  fileName     String?      @db.VarChar(255) @map("file_name")
  mode         String       @db.VarChar(10)
  onError      String       @db.VarChar(15) @map("on_error")
  status       ImportStatus @default(previewed)
  totalRows    Int          @default(0) @map("total_rows")
  acceptedRows Int          @default(0) @map("accepted_rows")
  rejectedRows Int          @default(0) @map("rejected_rows")
  errorSummary Json?        @map("error_summary")
  importedBy   String?      @map("imported_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  completedAt  DateTime?    @map("completed_at") @db.Timestamptz

  company         Company          @relation(fields: [companyId], references: [id])
  importer        User?            @relation("ImportedBy", fields: [importedBy], references: [id])
  errors          DataImportError[]
  socialPosts     SocialPost[]
  regionalMetrics RegionalMetric[]
  salesRecords    SalesRecord[]

  @@index([companyId, createdAt(sort: Desc)])
  @@map("data_imports")
}

model DataImportError {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId   String  @map("import_id") @db.Uuid
  rowNumber  Int     @map("row_number")
  columnName String? @db.VarChar(100) @map("column_name")
  errorCode  String  @db.VarChar(50) @map("error_code")
  message    String
  rawRow     Json?   @map("raw_row")

  import DataImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("data_import_errors")
}

model SocialPost {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  platform       Platform
  externalPostId String?      @db.VarChar(100) @map("external_post_id")
  publishedAt    DateTime     @map("published_at") @db.Timestamptz
  contentType    ContentType? @map("content_type")
  captionPublic  String?      @map("caption_public")
  likes          Int?
  comments       Int?
  shares         Int?
  views          Int?
  reach          Int?
  impressions    Int?
  clicks         Int?
  sourceType     SourceType   @map("source_type")
  importId       String?      @db.Uuid @map("import_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  company Company     @relation(fields: [companyId], references: [id])
  import  DataImport? @relation(fields: [importId], references: [id])

  @@unique([companyId, platform, externalPostId], map: "uq_post_identity")
  @@index([companyId, platform, publishedAt(sort: Desc)])
  @@map("social_posts")
}

model RegionalMetric {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  wilayaCode  String     @map("wilaya_code") @db.Char(2)
  periodStart DateTime   @map("period_start") @db.Date
  periodEnd   DateTime   @map("period_end") @db.Date
  metricType  MetricType @map("metric_type")
  metricValue Decimal    @map("metric_value") @db.Decimal(18, 4)
  sourceType  SourceType @map("source_type")
  importId    String?    @db.Uuid @map("import_id")

  company Company     @relation(fields: [companyId], references: [id])
  wilaya  Wilaya      @relation(fields: [wilayaCode], references: [code])
  import  DataImport? @relation(fields: [importId], references: [id])

  @@unique([companyId, wilayaCode, periodStart, periodEnd, metricType, sourceType])
  @@index([companyId, periodStart, periodEnd])
  @@map("regional_metrics")
}

model SalesRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  orderDate       DateTime  @map("order_date") @db.Date
  wilayaCode      String?   @map("wilaya_code") @db.Char(2)
  productCategory String?   @db.VarChar(100) @map("product_category")
  orderCount      Int       @map("order_count")
  revenue         Decimal   @db.Decimal(14, 2)
  acquisitionCost Decimal?  @map("acquisition_cost") @db.Decimal(14, 2)
  sourceType      SourceType @map("source_type")
  importId        String?   @db.Uuid @map("import_id")

  company Company     @relation(fields: [companyId], references: [id])
  wilaya  Wilaya?     @relation(fields: [wilayaCode], references: [code])
  import  DataImport? @relation(fields: [importId], references: [id])

  @@index([companyId, orderDate(sort: Desc)])
  @@map("sales_records")
}

// ── System 7 Tables ───────────────────────────────────────────────────────────
model ScheduledItem {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  platform    Platform
  plannedAt   DateTime     @map("planned_at") @db.Timestamptz
  title       String       @db.VarChar(150)
  contentType ContentType? @map("content_type")
  notes       String?      @db.Text
  status      String       @default("planned") @db.VarChar(12) // 'planned' | 'done' | 'cancelled'
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id])
  creator User?   @relation("ScheduledBy", fields: [createdBy], references: [id])

  @@index([companyId, plannedAt])
  @@map("scheduled_items")
}

// ── System 8 Tables ───────────────────────────────────────────────────────────
model CampaignSimulation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String   @db.VarChar(120)
  budget          Decimal? @db.Decimal(14, 2)
  startDate       DateTime @map("start_date") @db.Date
  durationDays    Int      @map("duration_days")
  assumptionsJson Json     @map("assumptions_json")
  scenarioJson    Json     @map("scenario_json")
  isArchived      Boolean  @default(false) @map("is_archived")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User?   @relation("SimulationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId, isArchived])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("campaign_simulations")
}

// ── System 9 Tables ───────────────────────────────────────────────────────────
model Report {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String      @map("company_id") @db.Uuid
  createdBy    String?     @map("created_by") @db.Uuid
  reportType   ReportType  @map("report_type")
  title        String      @db.VarChar(150)
  periodStart  DateTime?   @map("period_start") @db.Date
  periodEnd    DateTime?   @map("period_end") @db.Date
  filtersJson  Json        @default("{}") @map("filters_json")
  dataMode     String      @default("real") @map("data_mode") @db.VarChar(5) // 'real' | 'demo'
  snapshotJson Json        @map("snapshot_json")
  sourcesJson  Json        @default("{}") @map("sources_json")
  fileUrl      String?     @map("file_url") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User?   @relation("ReportCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, reportType])
  @@map("reports")
}

